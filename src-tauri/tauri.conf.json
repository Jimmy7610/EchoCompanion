{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoCompanion",
  "version": "0.1.1",
  "identifier": "se.jimmyeliasson.echocompanion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EchoCompanion",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFMURENzEwQzNERkRGNEMKUldSTTM5L0RFTmNkenQxYisrN2NBQ1JPQWU5YzdTWVhwaUlMa0ppOHh3bDdBbHd2OUhHK21uWHgK",
      "endpoints": [
        "https://github.com/Jimmy7610/EchoCompanion/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
